{
  "name": "fitness-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private Fitness OS \u2014 transformation, treadmill, nutrition and recovery tracking",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test test/*.test.js",
    "test:e2e": "node scripts/e2e-static.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --local --port 8787 --persist-to worker/.wrangler/state",
    "worker:migrate:local": "wrangler d1 execute fitnessos --local --config worker/wrangler.toml --file worker/migrations/0001_init.sql --persist-to worker/.wrangler/state",
    "worker:migrate": "wrangler d1 migrations apply fitnessos --remote --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "legacy:start": "node legacy/server/index.js",
    "legacy:seed-demo": "node legacy/server/seed-demo.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.6",
    "dexie": "^4.4.6",
    "exifr": "^7.1.3",
    "express": "^4.21.0",
    "multer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.0.1",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.47.0",
    "typescript": "^5.6.2",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^3.114.17"
  }
}
